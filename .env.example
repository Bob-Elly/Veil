# ── Relayer (services/relayer) ── reads this root .env
# Funded Monad testnet key. Pays gas for private transfers/withdrawals and gas drips (0.05 MON per new user).
RELAYER_PK=
RPC_URL=https://testnet-rpc.monad.xyz
# DEPLOYMENTS=../../deployments/testnet.json   (default)
# PORT=3001

# ── Deploy scripts ──
DEPLOYER_PK=
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_RPC=https://rpc.monad.xyz

# ── Chainlink CRE & X API (services/cre) ──
X_BEARER_TOKEN=
CRE_ETH_PRIVATE_KEY=

# ── MetaMask plugin (packages/mm-plugin) ──
# VEIL_RELAYER_URL=http://localhost:3001
# VEIL_PASSPHRASE=   only needed if the wallet's signatures are non-deterministic
CVI_ATTESTER_PK=

# ── Web app: copy these into apps/web/.env.local ──
# NEXT_PUBLIC_RELAYER_URL=http://localhost:3001
# NEXT_PUBLIC_ENVIO_URL=        optional; leave empty to sync from the relayer cache
# NEXT_PUBLIC_AURORA_KEY=       free key from studio.aurora.dev (Fund from Base tab)
# NEXT_PUBLIC_CHAIN_ID=10143    use 31337 + NEXT_PUBLIC_POOL_USDC/TOKEN_USDC for a local anvil run
